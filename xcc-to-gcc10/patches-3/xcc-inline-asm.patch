+
+// The program header table describing itself (PT_PHDR).
+//
+// The kernel only reports AT_PHDR (the address of the program header table) to
+// the program when the executable carries a PT_PHDR entry; without it AT_PHDR
+// stays 0 and a C library that locates its own phdrs through AT_PHDR (musl's
+// __init_libc -> __init_tls does) dereferences the null pointer.
+void out_phdr_self(FILE *fp, uintptr_t offset, uintptr_t vaddr, size_t phnum) {
+  Elf64_Phdr phdr = {
+    .p_type   = PT_PHDR,
+    .p_offset = offset,
+    .p_vaddr  = vaddr,
+    .p_paddr  = vaddr,  // dummy
+    .p_filesz = phnum * sizeof(Elf64_Phdr),
+    .p_memsz  = phnum * sizeof(Elf64_Phdr),
+    .p_flags  = PF_R,
+    .p_align  = 8,
+  };
+
+  fwrite(&phdr, sizeof(Elf64_Phdr), 1, fp);
+}
