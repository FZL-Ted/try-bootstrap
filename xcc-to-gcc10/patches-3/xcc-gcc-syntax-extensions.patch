+  // as an identifier token (that is the only kind the token-glue helper
+  // accepts, and the text is what gets pasted).
+  Token *raw = alloc_token(TK_IDENT, lexer.line, start, p);
+  raw->ident = alloc_name(start, p, true);
+  *pp = p;
+  return raw;
