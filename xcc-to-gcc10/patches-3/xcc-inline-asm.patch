+// Emit "<op> r/m, r" (ModRM.reg = source register, r/m = destination).
+// `opcode2` < 0 selects a one byte opcode, otherwise a 0x0f prefixed opcode.
+static unsigned char *asm_rm_r(Inst *inst, Code *code, unsigned char opcode, int opcode2) {
+  const Operand *src = &inst->opr[0];
+  const Operand *dst = &inst->opr[1];
+  assert(src->type == REG);
+  enum RegSize size = src->reg.size;
+  int sno = opr_regno(&src->reg);
+  // A two byte (0x0f prefixed) opcode: the size selects the second byte.
+  unsigned char op1 = opcode2 >= 0 ? opcode : (size == REG8 ? opcode : (unsigned char)(opcode + 1));
+  unsigned char op2 = opcode2 >= 0 ? (size == REG8 ? opcode2 : (unsigned char)(opcode2 + 1)) : 0;
+  short buf[8];
+  int n = 0;
+  if (size == REG16)
+    buf[n++] = 0x66;
+
+  if (dst->type == REG) {
+    int dno = opr_regno(&dst->reg);
+    if (sno >= 8 || dno >= 8 || size == REG64)
+      buf[n++] = 0x40 | ((dno & 8) >> 3) | ((sno & 8) >> 1) | (size == REG64 ? 8 : 0);
+    buf[n++] = op1;
+    if (opcode2 >= 0)
+      buf[n++] = op2;
+    buf[n++] = 0xc0 | ((sno & 7) << 3) | (dno & 7);
+  } else if (dst->type == INDIRECT && dst->indirect.reg.no != RIP &&
+             (dst->indirect.offset.expr == NULL || dst->indirect.offset.expr->kind == EX_FIXNUM)) {
+    long offset = dst->indirect.offset.expr != NULL ? dst->indirect.offset.expr->fixnum : 0;
+    int bno = opr_regno(&dst->indirect.reg);
+    bool noofs = offset == 0 && (bno & 7) != RBP - RAX;
+    if (sno >= 8 || bno >= 8 || size == REG64)
+      buf[n++] = 0x40 | ((bno & 8) >> 3) | ((sno & 8) >> 1) | (size == REG64 ? 8 : 0);
+    buf[n++] = op1;
+    if (opcode2 >= 0)
+      buf[n++] = op2;
+    buf[n++] = (noofs ? 0x00 : is_im8(offset) ? 0x40 : 0x80) | (bno & 7) | ((sno & 7) << 3);
+    if ((bno & 7) == RSP - RAX)
+      buf[n++] = 0x24;
+
+    unsigned char *p = code->buf;
+    p = put_code_filtered(p, buf, n);
+    if (!noofs) {
+      if (is_im8(offset)) {
+        *p++ = IM8(offset);
+      } else if (is_im32(offset)) {
+        PUT_CODE(p, IM32(offset));
+        p += 4;
+      } else {
+        return NULL;
+      }
+    }
+    return p;
+  } else {
+    return NULL;
+  }
+
+  unsigned char *p = code->buf;
+  p = put_code_filtered(p, buf, n);
+  return p;
+}
+
+#define DEF_ASM_RM_R(name, opcode, opcode2) \
+  static unsigned char *name(Inst *inst, Code *code) { return asm_rm_r(inst, code, opcode, opcode2); }
+
+DEF_ASM_RM_R(asm_and_ir, 0x20, -1)
+DEF_ASM_RM_R(asm_or_ir, 0x08, -1)
+DEF_ASM_RM_R(asm_xor_ir, 0x30, -1)
+DEF_ASM_RM_R(asm_xchg_rr, 0x86, -1)
+DEF_ASM_RM_R(asm_xchg_ir, 0x86, -1)
+DEF_ASM_RM_R(asm_xadd_rr, 0x0f, 0xc0)
+DEF_ASM_RM_R(asm_xadd_ir, 0x0f, 0xc0)
+DEF_ASM_RM_R(asm_cmpxchg_rr, 0x0f, 0xb0)
+DEF_ASM_RM_R(asm_cmpxchg_ir, 0x0f, 0xb0)
+
+// "or $imm, r/m"
+static unsigned char *asm_or_imi(Inst *inst, Code *code) {
+  const Operand *dst = &inst->opr[1];
+  if (dst->type != INDIRECT || dst->indirect.reg.no == RIP ||
+      (dst->indirect.offset.expr != NULL && dst->indirect.offset.expr->kind != EX_FIXNUM))
+    return NULL;
+  long offset = dst->indirect.offset.expr != NULL ? dst->indirect.offset.expr->fixnum : 0;
+  long value = inst->opr[0].immediate;
+  // A size suffix ("orl"/"orq") picks the operand size; without one assume 32 bit.
+  enum RegSize size = inst->suffix_size != 0 ? inst->suffix_size - 1 : REG32;
+  if (size != REG32 && size != REG64)
+    return NULL;
+  int bno = opr_regno(&dst->indirect.reg);
+  bool noofs = offset == 0 && (bno & 7) != RBP - RAX;
+  short buf[] = {
+    (size == REG64 || bno >= 8) ? 0x40 | ((bno & 8) >> 3) | (size == REG64 ? 8 : 0) : -1,
+    is_im8(value) ? 0x83 : 0x81,
+    (noofs ? 0x00 : is_im8(offset) ? 0x40 : 0x80) | (bno & 7) | (1 << 3),
+    (bno & 7) == RSP - RAX ? 0x24 : -1,
+  };
+  unsigned char *p = code->buf;
+  p = put_code_filtered(p, buf, ARRAY_SIZE(buf));
+  if (!noofs) {
+    if (is_im8(offset)) {
+      *p++ = IM8(offset);
+    } else if (is_im32(offset)) {
+      PUT_CODE(p, IM32(offset));
+      p += 4;
+    } else {
+      return NULL;
+    }
+  }
+  if (is_im8(value)) {
+    *p++ = IM8(value);
+  } else if (is_im32(value)) {
+    PUT_CODE(p, IM32(value));
+    p += 4;
+  } else {
+    return NULL;
+  }
+  return p;
+}
+
+static unsigned char *asm_bsf(Inst *inst, Code *code) {
+  enum RegSize size = inst->opr[0].reg.size;
+  int sno = opr_regno(&inst->opr[0].reg);
+  int dno = opr_regno(&inst->opr[1].reg);
+  short buf[] = {
+    MAKE_REX0(size, dno, sno, 0x0f),
+    0xbc,
+    0xc0 | ((dno & 7) << 3) | (sno & 7),
+  };
+  unsigned char *p = code->buf;
+  p = put_code_filtered(p, buf, ARRAY_SIZE(buf));
+  return p;
+}
+
+static unsigned char *asm_hlt(Inst *inst, Code *code) {
+  UNUSED(inst);
+  MAKE_CODE(inst, code, 0xf4);
+  return code->buf;
+}
+
+static unsigned char *asm_pause(Inst *inst, Code *code) {
+  UNUSED(inst);
+  MAKE_CODE(inst, code, 0xf3, 0x90);
+  return code->buf;
+}
+
 static unsigned char *asm_bsr(Inst *inst, Code *code) {
   enum RegSize size = inst->opr[0].reg.size;
   int sno = opr_regno(&inst->opr[0].reg);
@@ -1664,6 +1822,14 @@ static const AsmInstFunc table[] = {
   [CLTD] = asm_cltd,
