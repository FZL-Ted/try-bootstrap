+    for (int j = 0; j < ex->len; ++j)
+      vec_push(out, ex->data[j]);
+  }
+  if (out != NULL)
+    init->multi = out;
+}
+
+static Vector *expand_range_initializer(Initializer *init) {
+  switch (init->kind) {
+  case IK_RANGE:
+    {
+      Vector *out = new_vector();
+      for (size_t i = init->range.index; i <= init->range.index2; ++i) {
