+/* ========================= Exact conversion of decimal float literals =========================
+ *
+ * The old implementation (accumulate `result*10+digit` as double, then scale by repeated squaring via `ipow(10,n)`)
+ * was correct only for small |exponent| and at most 15 significant digits:
+ *   - `2.2250738585072014e-308` was off by about 5 ulp;
+ *   - `4.94065645841246544177e-324` (DBL_TRUE_MIN) underflowed to 0.
+ * Such literals are common in real code (DBL_MIN / DBL_TRUE_MIN / FLT_MAX ...),
+ * and libraries such as MPFR use them as expected values.
+ *
+ * This version performs an **exact** conversion: collect the significant digits into a big integer D, giving `value = D * 10^exp10`,
+ * then turn that into the exact fraction `num / den` with big integers:
+ *     exp10 >= 0 :  num = D * 10^exp10,  den = 1
+ *     exp10 <  0 :  num = D,             den = 10^(-exp10)
+ * Then do a long division with remainder, keep 57 quotient bits, and use "remainder != 0" as the sticky bit
+ * to round to 53 bits with round-to-nearest-even (subnormals round at the available precision).
+ * The result is **correctly rounded** and uses no intermediate floating-point arithmetic.
+ *
+ * Limits: at most MAX_DIGITS decimal significant digits; big integers have BIG_LIMBS 32-bit limbs.
+ * A decimal-magnitude overflow/underflow short-circuit runs first so the big integers stay bounded.
+ * ========================================================================== */
+
+#define BIG_LIMBS   96    /* 96*32 = 3072 bits: enough for 256 significant digits + 10^±580 */
+#define MAX_DIGITS  256
+
+typedef struct {
+  uint32_t v[BIG_LIMBS];  /* little-endian: v[0] is the least significant 32 bits */
+  int len;                /* number of significant limbs; 0 means zero */
+} Big;
+
+static void big_zero(Big *a) { a->len = 0; }
+static bool big_is_zero(const Big *a) { return a->len == 0; }
+
+static int bitlen64(uint64_t x) {
+  int n = 0;
+  while (x != 0) {
+    ++n;
+    x >>= 1;
+  }
+  return n;
+}
+
+static int big_bitlen(const Big *a) {
+  uint32_t t;
+  int b = 0;
+  if (a->len == 0)
+    return 0;
+  t = a->v[a->len - 1];
+  while (t != 0) {
+    ++b;
+    t >>= 1;
+  }
+  return (a->len - 1) * 32 + b;
+}
+
+static void big_mul_small(Big *a, uint32_t m) {
+  uint64_t carry = 0;
+  int i;
+  for (i = 0; i < a->len; ++i) {
+    uint64_t t = (uint64_t)a->v[i] * m + carry;
+    a->v[i] = (uint32_t)t;
+    carry = t >> 32;
+  }
+  if (carry != 0 && a->len < BIG_LIMBS)
+    a->v[a->len++] = (uint32_t)carry;
+}
+
+static void big_add_small(Big *a, uint32_t m) {
+  uint64_t carry = m;
+  int i;
+  for (i = 0; i < a->len && carry != 0; ++i) {
+    uint64_t t = (uint64_t)a->v[i] + carry;
+    a->v[i] = (uint32_t)t;
+    carry = t >> 32;
+  }
+  if (carry != 0 && a->len < BIG_LIMBS)
+    a->v[a->len++] = (uint32_t)carry;
+}
+
+/* a *= 10^k */
+static void big_mul_pow10(Big *a, long k) {
+  long i;
+  for (i = 0; i < k; ++i)
+    big_mul_small(a, 10);
+}
+
+static void big_shl(Big *a, int bits) {
+  int words, sb, i;
+  if (a->len == 0 || bits <= 0)
+    return;
+  words = bits >> 5;
+  sb = bits & 31;
+  if (words != 0) {
+    if (a->len + words > BIG_LIMBS)
+      a->len = BIG_LIMBS - words;  /* should not happen (magnitude short-circuit above) */
+    for (i = a->len - 1; i >= 0; --i)
+      a->v[i + words] = a->v[i];
+    for (i = 0; i < words; ++i)
+      a->v[i] = 0;
+    a->len += words;
+  }
+  if (sb != 0) {
+    uint32_t carry = 0;
+    for (i = 0; i < a->len; ++i) {
+      uint32_t nv = (uint32_t)((a->v[i] << sb) | carry);
+      carry = a->v[i] >> (32 - sb);
+      a->v[i] = nv;
+    }
+    if (carry != 0 && a->len < BIG_LIMBS)
+      a->v[a->len++] = carry;
+  }
+}
+
+static void big_shr1(Big *a) {
+  uint32_t carry = 0;
+  int i;
+  for (i = a->len; i-- > 0;) {
+    uint32_t nv = (a->v[i] >> 1) | (carry << 31);
+    carry = a->v[i] & 1u;
+    a->v[i] = nv;
+  }
+  while (a->len > 0 && a->v[a->len - 1] == 0)
+    --a->len;
+}
+
+static int big_cmp(const Big *a, const Big *b) {
+  int i;
+  if (a->len != b->len)
+    return a->len < b->len ? -1 : 1;
+  for (i = a->len; i-- > 0;) {
+    if (a->v[i] != b->v[i])
+      return a->v[i] < b->v[i] ? -1 : 1;
+  }
+  return 0;
+}
+
+/* a -= b; requires a >= b */
+static void big_sub(Big *a, const Big *b) {
+  int32_t borrow = 0;
+  int i;
+  for (i = 0; i < a->len; ++i) {
+    int64_t t = (int64_t)a->v[i] - (i < b->len ? (int64_t)b->v[i] : 0) - borrow;
+    if (t < 0) {
+      t += ((int64_t)1 << 32);
+      borrow = 1;
+    } else {
+      borrow = 0;
+    }
+    a->v[i] = (uint32_t)t;
+  }
+  while (a->len > 0 && a->v[a->len - 1] == 0)
+    --a->len;
+}
+
+static double u64_to_double(uint64_t bits) {
+  union {
+    uint64_t u;
+    double d;
+  } x;
+  x.u = bits;
+  return x.d;
+}
+/* Correctly round num/den to double (num and den are exact positive integers). */
+static double big_to_double(const Big *num, const Big *den, bool neg) {
+  Big a, b, bs;
+  uint64_t q = 0;
+  int bn = big_bitlen(num), bd = big_bitlen(den);
+  int s = bd + 56 - bn;
+  int i, nb, qtop, prec, ulp, shift, top;
+  bool sticky;
+  uint64_t m, bits;
+  double inf = 1.0 / 0.0;
+
+  a = *num;
+  b = *den;
+  if (s >= 0)
+    big_shl(&a, s);
+  else
+    big_shl(&b, -s);
+
+  /* Long division: q = floor(a / b), keeping 57 bits (top bit index 56). */
+  bs = b;
+  big_shl(&bs, 56);
+  for (i = 56; i >= 0; --i) {
+    if (big_cmp(&a, &bs) >= 0) {
+      big_sub(&a, &bs);
+      q |= ((uint64_t)1) << i;
+    }
+    big_shr1(&bs);
+  }
+  sticky = !big_is_zero(&a);
+  nb = bitlen64(q);
+
+  /* value = q * 2^-s. Choose precision and ulp exponent from the unrounded magnitude. */
+  qtop = nb - 1 - s;
+  if (qtop >= -1022) {
+    prec = 53;
+  } else {
+    prec = qtop + 1075;  /* qtop + 1074 + 1: available subnormal bits */
+    if (prec < 1)
+      prec = 1;
+  }
+  ulp = qtop - prec + 1;
+  if (ulp < -1074) {
+    ulp = -1074;
+    prec = qtop + 1075;
+    if (prec < 1)
+      prec = 1;
+  }
+
+  /* Round q to prec bits (round-to-nearest-even: low bits and the remainder decide).
+     Right-shift amount = s + ulp (value = q*2^-s; target quantum is 2^ulp).
+     Note that after ulp is clamped to -1074 this is no longer nb-prec -- use it as is,
+     otherwise a value like 1e-324, smaller than DBL_TRUE_MIN, becomes 2*DBL_TRUE_MIN. */
+  shift = s + ulp;
+  if (shift <= 0) {
+    m = q << (-shift);
+  } else {
+    uint64_t dropped = q & ((((uint64_t)1) << shift) - 1);
+    uint64_t half = ((uint64_t)1) << (shift - 1);
+    m = q >> shift;
+    if (dropped > half || (dropped == half && (sticky || (m & 1) != 0)))
+      ++m;
+  }
+  /* m gains a bit only on an exact carry, in which case a one-bit shift is exact. */
+  while (m != 0 && bitlen64(m) > 53) {
+    m >>= 1;
+    ++ulp;
+  }
+  if (m == 0)
+    return neg ? -0.0 : 0.0;
+
+  top = ulp + bitlen64(m) - 1;  /* binary exponent of the most significant bit */
+  if (top > 1023)
+    return neg ? -inf : inf;
+  if (top >= -1022) {
+    int l = 53 - bitlen64(m);
+    uint64_t mant = m << l;
+    uint64_t e = (uint64_t)(top + 1023);
+    bits = (e << 52) | (mant & ((((uint64_t)1) << 52) - 1));
+  } else {
+    bits = m;  /* subnormal: ulp == -1074 here, so m is the mantissa field directly */
+  }
+  if (neg)
+    bits |= ((uint64_t)1) << 63;
+  return u64_to_double(bits);
+}
