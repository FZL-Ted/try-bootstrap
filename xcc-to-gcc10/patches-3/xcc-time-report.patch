+extern double cg_time_mapvirt, cg_time_liveregs, cg_time_stackframe;
+static double cg_now(void) {
+  struct timespec ts;
+  clock_gettime((clockid_t)2 /* CLOCK_PROCESS_CPUTIME_ID */, &ts);
+  return (double)ts.tv_sec + (double)ts.tv_nsec * 1e-9;
+}
+static int cg_timing(void) {
+  static int e = -1;
+  if (e < 0) e = getenv("XCC_TIME") != NULL;
