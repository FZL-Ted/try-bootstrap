+  { bool tm = cg_timing(); double t0 = tm ? cg_now() : 0;
+    gen_stmt(func->body_block);
+    if (tm) cg_time_stmts += cg_now() - t0; }
 
   set_curbb(fnbe->ret_bb);
   curbb = NULL;
-  detect_from_bbs(fnbe->bbcon);
+  { bool tm = cg_timing(); double t0 = tm ? cg_now() : 0;
+    detect_from_bbs(fnbe->bbcon);
+    if (tm) cg_time_frombbs += cg_now() - t0; }
 
   curfunc = NULL;
   static_vars = NULL;
@@ -1421,15 +1444,38 @@ static inline void gen_defun_after(Function *func) {
 
   optimize(fnbe->ra, fnbe->bbcon);
 
+  bool tm = cg_timing();
+  double t0 = tm ? cg_now() : 0, t = t0;
   prepare_register_allocation(func);
+  if (tm) { cg_time_prep += cg_now() - t; t = cg_now(); }
   tweak_irs(fnbe);
+  if (tm) { cg_time_tweak += cg_now() - t; t = cg_now(); }
   analyze_reg_flow(fnbe->bbcon);
+  if (tm) { cg_time_regflow += cg_now() - t; t = cg_now(); }
 
   alloc_physical_registers(fnbe->ra, fnbe->bbcon);
+  if (tm) { cg_time_physalloc += cg_now() - t; t = cg_now(); }
   map_virtual_to_physical_registers(fnbe->ra);
+  if (tm) { cg_time_mapvirt += cg_now() - t; t = cg_now(); }
   detect_living_registers(fnbe->ra, fnbe->bbcon);
+  if (tm) { cg_time_liveregs += cg_now() - t; t = cg_now(); }
 
   alloc_stack_variables_onto_stack_frame(func);
+  if (tm) { cg_time_stackframe += cg_now() - t; }
+  if (tm) {
+    double el = cg_now() - t0;
+    cg_time_regalloc += el;
