+  Vector *out = NULL;
+  for (int i = 0; i < multi->len; ++i) {
+    Initializer *elem = multi->data[i];
+    Vector *ex = elem != NULL ? expand_range_initializer(elem) : NULL;
+    if (ex == NULL) {
