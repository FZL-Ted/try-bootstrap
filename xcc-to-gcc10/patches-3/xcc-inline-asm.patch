+  } kClobbers[] = {
+    {"rax", ASM_REG_RAX}, {"eax", ASM_REG_RAX}, {"ax", ASM_REG_RAX}, {"al", ASM_REG_RAX},
+    {"rbx", ASM_REG_RBX}, {"ebx", ASM_REG_RBX}, {"bx", ASM_REG_RBX}, {"bl", ASM_REG_RBX},
+    {"rcx", ASM_REG_RCX}, {"ecx", ASM_REG_RCX}, {"cx", ASM_REG_RCX}, {"cl", ASM_REG_RCX},
+    {"rdx", ASM_REG_RDX}, {"edx", ASM_REG_RDX}, {"dx", ASM_REG_RDX}, {"dl", ASM_REG_RDX},
+    {"rsi", ASM_REG_RSI}, {"esi", ASM_REG_RSI}, {"si", ASM_REG_RSI}, {"sil", ASM_REG_RSI},
