+    if (tm && (i % 100) == 99)
+      fprintf(stderr,
+              "[xcc-prog]   decls=%d/%d allocvars=%.2f stmts=%.2f physalloc=%.2f "
+              "regalloc=%.2f\n",
+              i + 1, len, cg_time_allocvars, cg_time_stmts, cg_time_physalloc,
+              cg_time_regalloc);
   }
 }
