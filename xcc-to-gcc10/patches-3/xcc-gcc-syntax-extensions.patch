+// which rewrites an initializer (e.g. check_global_initializer() casting the
+// value) does not see the very same node several times.
+static Initializer *clone_initializer(const Initializer *init) {
+  if (init == NULL)
+    return NULL;
+  Initializer *clone = new_initializer(init->kind, init->token);
+  switch (init->kind) {
+  case IK_SINGLE:
+    clone->single = init->single;
+    break;
+  case IK_MULTI:
+    {
+      Vector *multi = new_vector();
+      for (int i = 0; i < init->multi->len; ++i)
+        vec_push(multi, clone_initializer(init->multi->data[i]));
+      clone->multi = multi;
+      break;
+    }
+  case IK_DOT:
+    clone->dot.name = init->dot.name;
+    clone->dot.value = clone_initializer(init->dot.value);
+    break;
+  case IK_BRKT:
+    clone->bracket.index = init->bracket.index;
+    clone->bracket.value = clone_initializer(init->bracket.value);
+    break;
+  case IK_RANGE:
+    clone->range.index = init->range.index;
+    clone->range.index2 = init->range.index2;
+    clone->range.value = clone_initializer(init->range.value);
+    break;
+  }
+  return clone;
+}
