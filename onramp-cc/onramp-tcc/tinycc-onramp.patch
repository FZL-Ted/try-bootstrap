--- a/libtcc.c
+++ b/libtcc.c
@@ -2226,6 +2226,9 @@ PUB_FUNC void tcc_print_stats(TCCState *s1, unsigned total_time)
 {
     if (!total_time)
         total_time = 1;
+    #ifdef __onramp__
