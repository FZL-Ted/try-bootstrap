diff --git a/tcc.h b/tcc.h
index c73eed83..e09fc875 100644
--- a/tcc.h
+++ b/tcc.h
@@ -50,6 +50,14 @@ extern float strtof (const char *__nptr, char **__endptr);
 extern long double strtold (const char *__nptr, char **__endptr);
 #endif
 
+/* Onramp's libc has no long double implementation (long double is the same as
+   double under TCC_USING_DOUBLE_FOR_LDOUBLE) and does not provide strtold()
+   or ldexpl(), so fall back to their double equivalents. */
+#ifdef __onramp__
+# define strtold (long double)strtod
+# define ldexpl ldexp
+#endif
+
 #ifdef _WIN32
 # define WIN32_LEAN_AND_MEAN 1
 # ifndef _WIN32_WINNT
@@ -120,6 +128,10 @@ extern long double strtold (const char *__nptr, char **__endptr);
 # define NORETURN __declspec(noreturn)
 # define ALIGNED(x) __declspec(align(x))
 # define PRINTF_LIKE(x,y)
+#elif defined(__onramp_cci__)
+# define NORETURN _Noreturn
+# define ALIGNED(x) /*nothing*/
+# define PRINTF_LIKE(x,y) /*nothing*/
 #else
 # define NORETURN __attribute__((noreturn))
 # define ALIGNED(x) __attribute__((aligned(x)))
@@ -237,7 +249,8 @@ extern long double strtold (const char *__nptr, char **__endptr);
 /* No ten-byte long doubles on window and macos except in
    cross-compilers made by a mingw-GCC */
 #if defined TCC_TARGET_PE \
-    || (defined TCC_TARGET_MACHO && defined TCC_TARGET_ARM64)
+    || (defined TCC_TARGET_MACHO && defined TCC_TARGET_ARM64) \
+    || defined __onramp__
 # define TCC_USING_DOUBLE_FOR_LDOUBLE 1
 #endif
 
