diff --git a/src/cc/cc1.c b/src/cc/cc1.c
index 910f9ac..c7f7202 100644
--- a/src/cc/cc1.c
+++ b/src/cc/cc1.c
@@ -2,12 +2,14 @@
 
 #include <ctype.h>
 #include <assert.h>
+#include <time.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
 #include "codegen.h"
 #include "emit_code.h"
+#include "optimize.h"
 #include "fe_misc.h"
 #include "lexer.h"
 #include "parser.h"
@@ -15,6 +17,30 @@
 #include "util.h"
 #include "var.h"
 
+// codegen sub-timer accumulators (extern in codegen.c; accumulated there)
+double cg_time_allocvars, cg_time_stmts, cg_time_frombbs, cg_time_regalloc;
+// Fine-grained timing for gen_defun_after() (accumulated in codegen.c): find hotspots in register allocation + frame layout
+double cg_time_prep, cg_time_tweak, cg_time_regflow, cg_time_physalloc;
+double cg_time_mapvirt, cg_time_liveregs, cg_time_stackframe;
+// Per-step timing and round count for the alloc_physical_registers() fixpoint (accumulated in regalloc.c)
+double ra_time_check, ra_time_sort, ra_time_detect, ra_time_scan, ra_time_insert;
+int ra_round_count, ra_round_max;
+
+// With XCC_TIME=1, print **process CPU time** per phase to find which pass makes a file compile very slowly.
+// Use clock_gettime(CLOCK_PROCESS_CPUTIME_ID) instead of clock(): xcc's bundled libc has **no**
+// clock() (gen2 is built with xcc's own libc; a missing declaration makes it report "cannot call except function"),
+// whereas clock_gettime is implemented in xcc/libsrc/unistd/clock_gettime.c (raw syscall).
+// Do not use wall-clock either: machine suspend makes it wildly inaccurate.
+#ifndef CLOCK_PROCESS_CPUTIME_ID
+#define CLOCK_PROCESS_CPUTIME_ID 2  /* Linux ABI; xcc's time.h defines only REALTIME */
+#endif
+static double xcc_cpu_now(void) {
+  struct timespec ts;
+  if (clock_gettime((clockid_t)CLOCK_PROCESS_CPUTIME_ID, &ts) != 0)
+    return 0.0;
+  return (double)ts.tv_sec + (double)ts.tv_nsec * 1e-9;
+}
+
 ////////////////////////////////////////////////
 
 extern void install_builtins(Vector *decls);
@@ -167,6 +193,9 @@ int main(int argc, char *argv[]) {
 
