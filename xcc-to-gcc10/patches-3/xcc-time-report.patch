+    double ts = xcc_time ? xcc_cpu_now() : 0.0;
     compile1(ifp, filename, toplevel);
+    if (xcc_time) t_parse += xcc_cpu_now() - ts;
     if (ifp != stdin)
       fclose(ifp);
   }
@@ -190,8 +221,53 @@ int main(int argc, char *argv[]) {
   if (cc_flags.warn_as_error && compile_warning_count != 0)
     exit(2);
 
-  gen(toplevel);
-  emit_code(toplevel);
+  // Progress printing: the whole file may be killed by a CPU limit, so the final XCC_TIME summary would be lost;
+  // therefore report immediately after each pass (together with codegen.c's every-100-declarations report).
+  if (xcc_time)
+    fprintf(stderr, "[xcc-prog] parse=%.3f decls=%d\n", t_parse, toplevel->len);
+
+  if (xcc_time) {
+    double ts = xcc_cpu_now();
+    gen(toplevel);
+    t_gen = xcc_cpu_now() - ts;
+    fprintf(stderr, "[xcc-prog] gen=%.3f (decls=%d)\n", t_gen, toplevel->len);
+  } else {
+    gen(toplevel);
+  }
+  if (xcc_time) {
+    double ts = xcc_cpu_now();
+    emit_code(toplevel);
+    t_emit = xcc_cpu_now() - ts;
+    fprintf(stderr, "[xcc-prog] emit=%.3f\n", t_emit);
+  } else {
+    emit_code(toplevel);
+  }
+
+  if (xcc_time) {
+    double total = xcc_cpu_now() - t0;
+    fprintf(stderr,
+            "[xcc-time] parse=%.3f gen=%.3f emit=%.3f total=%.3f (CPU seconds)\n",
+            t_parse, t_gen, t_emit, total);
+    fprintf(stderr,
+            "[xcc-time]   optimize: clear=%.3f peephole=%.3f ssa=%.3f "
+            "rm_unused=%.3f rm_bb=%.3f from_bbs=%.3f\n",
+            opt_time_clear, opt_time_peephole, opt_time_ssa,
+            opt_time_unused, opt_time_rmbb, opt_time_from);
+    fprintf(stderr,
+            "[xcc-time]   codegen: alloc_vars=%.3f stmts=%.3f from_bbs=%.3f "
+            "reg_alloc_and_frames=%.3f\n",
+            cg_time_allocvars, cg_time_stmts, cg_time_frombbs, cg_time_regalloc);
+    fprintf(stderr,
+            "[xcc-time]     defun_after: prep=%.3f tweak=%.3f regflow=%.3f "
+            "physalloc=%.3f mapvirt=%.3f liveregs=%.3f stackframe=%.3f\n",
+            cg_time_prep, cg_time_tweak, cg_time_regflow, cg_time_physalloc,
+            cg_time_mapvirt, cg_time_liveregs, cg_time_stackframe);
+    fprintf(stderr,
+            "[xcc-time]     alloc_phys: check=%.3f sort=%.3f detect=%.3f scan=%.3f "
+            "spill_insert=%.3f rounds=%d max=%d\n",
+            ra_time_check, ra_time_sort, ra_time_detect, ra_time_scan, ra_time_insert,
+            ra_round_count, ra_round_max);
+  }
 
   return 0;
 }
