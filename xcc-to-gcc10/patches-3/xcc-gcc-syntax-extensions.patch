+// the preprocessor has to keep things like `3DNOW`, `1B` or `1.2.3` as *one*
+// token, because `##` pastes raw pp-number text.  binutils' gas does exactly
+// that (gas/config/tc-i386.c):
+//     #define SUBARCH(n, e, d, s) ... CPU_ ## e ## _FLAGS ...
+//     SUBARCH (3dnow, 3DNOW, ANY_3DNOW, false)
+// so `CPU_ ## 3DNOW ## _FLAGS` must glue into the single identifier
+// `CPU_3DNOW_FLAGS`.  `read_num` only accepts real C literals, hence it used to
+// split `3DNOW` into `3` + `DNOW` and the paste produced two wrong tokens.
+static Token *read_pp_number(const char **pp) {
+  const char *start = *pp, *p = start;
+  if (*p == '.')
+    ++p;  // `.` digit
+  for (;; ++p) {
+    unsigned char c = *p;
+    if (isalnum(c) || c == '_' || c == '.')
+      continue;
+    if ((c == '+' || c == '-') && p > start &&
+        (tolower(p[-1]) == 'e' || tolower(p[-1]) == 'p'))
+      continue;
